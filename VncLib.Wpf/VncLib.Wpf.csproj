<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows;net9.0-windows;net10.0-windows</TargetFrameworks>
    <UseWpf>true</UseWpf>
    <Product>VncLib.Wpf</Product>
    <PackageId>VncLib.Wpf</PackageId>
    <Title>VncLib.Wpf</Title>
    <Description>WPF control for VncLib — renders a remote VNC screen and forwards keyboard/mouse input. Depends on the UI-neutral VncLib core.</Description>
    <PackageTags>vnc;rfb;remote-desktop;wpf;control</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VncLib\VncLib.csproj" />
  </ItemGroup>
</Project>