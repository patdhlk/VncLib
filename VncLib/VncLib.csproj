<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <Product>VncLib</Product>
    <PackageId>VncLib</PackageId>
    <Title>VncLib</Title>
    <Description>UI-framework neutral implementation of the VNC Remote Framebuffer (RFB) protocol for .NET. Ships the protocol engine (RfbClient) and a raw-framebuffer façade consumed by the VncLib.Wpf and VncLib.Avalonia UI controls.</Description>
    <PackageTags>vnc;rfb;remote-desktop;remoteframebuffer;protocol</PackageTags>
  </PropertyGroup>
</Project>
