<Project>
  <PropertyGroup>
    <Authors>patdhlk</Authors>
    <Company>VncLib</Company>
    <Copyright>Copyright 2018 The VncLib Authors</Copyright>
    <VersionPrefix>2.0.0</VersionPrefix>

    <!-- Allow building the Windows-targeting (WPF / net*-windows) projects on any OS. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>

    <!-- Shared NuGet / repository metadata. -->
    <PackageProjectUrl>https://github.com/patdhlk/vnclib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/patdhlk/vnclib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
